<Window x:Class="CodexRadarHost.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="众测雷达 · GPT 模型评分" Height="880" Width="1220"
        MinHeight="680" MinWidth="900" Background="#05080A" Foreground="#C9E8D2"
        WindowStartupLocation="CenterScreen" FontFamily="Microsoft YaHei UI">
  <Window.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#0A100A" />
    <SolidColorBrush x:Key="LineBrush" Color="#24402C" />
    <Style x:Key="RadarColumnHeaderStyle" TargetType="DataGridColumnHeader">
      <Setter Property="Foreground" Value="#B8FFCC" />
      <Setter Property="Background" Value="#143822" />
      <Setter Property="BorderBrush" Value="#2A6E45" />
      <Setter Property="BorderThickness" Value="0,0,1,1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="DataGridColumnHeader">
            <Border Background="#143822" BorderBrush="#2A6E45" BorderThickness="0,0,1,1" Padding="7,0">
              <TextBlock Text="{TemplateBinding Content}" Foreground="#B8FFCC" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#0F2118" />
      <Setter Property="Foreground" Value="#00E5FF" />
      <Setter Property="BorderBrush" Value="#2A6E67" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,7" />
      <Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="Cursor" Value="Hand" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#123B32" />
          <Setter Property="BorderBrush" Value="#00E5FF" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Background" Value="#0F1810" />
      <Setter Property="Foreground" Value="#8BB99A" />
      <Setter Property="BorderBrush" Value="#24402C" />
      <Setter Property="Padding" Value="12,6" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#0D322B" />
          <Setter Property="Foreground" Value="#00E5FF" />
          <Setter Property="BorderBrush" Value="#00E5FF" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="Background" Value="#0A100A" />
      <Setter Property="Foreground" Value="#C9E8D2" />
      <Setter Property="BorderBrush" Value="#24402C" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="RowBackground" Value="#0A100A" />
      <Setter Property="AlternatingRowBackground" Value="#0D1810" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#1B3020" />
      <Setter Property="VerticalGridLinesBrush" Value="#1B3020" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="ColumnHeaderHeight" Value="34" />
      <Setter Property="CanUserResizeColumns" Value="True" />
      <Setter Property="RowStyle">
        <Setter.Value>
          <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#C9E8D2" />
            <Setter Property="Background" Value="#0A100A" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ModelId}" Value="gpt-6-astra"><Setter Property="Background" Value="#21150C" /></DataTrigger>
              <DataTrigger Binding="{Binding ModelId}" Value="gpt-6-sol"><Setter Property="Background" Value="#211D0A" /></DataTrigger>
              <DataTrigger Binding="{Binding ModelId}" Value="gpt-6-luna"><Setter Property="Background" Value="#121C22" /></DataTrigger>
              <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#124633" /><Setter Property="Foreground" Value="#FFFFFF" /></Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
      <Setter Property="CellStyle">
        <Setter.Value>
          <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#C9E8D2" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#124633" />
                <Setter Property="Foreground" Value="#FFFFFF" />
              </Trigger>
            </Style.Triggers>
          </Style>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ModelCell">
      <TextBlock Text="{Binding Model}" FontWeight="Bold" Margin="5,0">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#00E5FF" />
            <Style.Triggers>
              <DataTrigger Binding="{Binding ModelId}" Value="gpt-6-astra"><Setter Property="Foreground" Value="#FB923C" /></DataTrigger>
              <DataTrigger Binding="{Binding ModelId}" Value="gpt-6-sol"><Setter Property="Foreground" Value="#FBBF24" /></DataTrigger>
              <DataTrigger Binding="{Binding ModelId}" Value="gpt-6-luna"><Setter Property="Foreground" Value="#D5DBE5" /></DataTrigger>
              <DataTrigger Binding="{Binding ModelId}" Value="gpt-5.6-terra"><Setter Property="Foreground" Value="#60A5FA" /></DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
    </DataTemplate>
    <DataTemplate x:Key="EffortCell">
      <Border x:Name="Badge" CornerRadius="7" BorderThickness="1" BorderBrush="#C084FC" Background="#26162F" Padding="7,2" HorizontalAlignment="Left" Margin="4,2">
        <TextBlock x:Name="BadgeText" Text="{Binding Effort}" Foreground="#C084FC" FontWeight="SemiBold" FontFamily="Consolas" />
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Effort}" Value="medium"><Setter TargetName="Badge" Property="BorderBrush" Value="#F59E0B" /><Setter TargetName="Badge" Property="Background" Value="#2B210C" /><Setter TargetName="BadgeText" Property="Foreground" Value="#F59E0B" /></DataTrigger>
        <DataTrigger Binding="{Binding Effort}" Value="high"><Setter TargetName="Badge" Property="BorderBrush" Value="#22D3EE" /><Setter TargetName="Badge" Property="Background" Value="#0C2830" /><Setter TargetName="BadgeText" Property="Foreground" Value="#22D3EE" /></DataTrigger>
        <DataTrigger Binding="{Binding Effort}" Value="xhigh"><Setter TargetName="Badge" Property="BorderBrush" Value="#4ADE80" /><Setter TargetName="Badge" Property="Background" Value="#102819" /><Setter TargetName="BadgeText" Property="Foreground" Value="#4ADE80" /></DataTrigger>
        <DataTrigger Binding="{Binding Effort}" Value="max"><Setter TargetName="Badge" Property="BorderBrush" Value="#60A5FA" /><Setter TargetName="Badge" Property="Background" Value="#10223A" /><Setter TargetName="BadgeText" Property="Foreground" Value="#60A5FA" /></DataTrigger>
        <DataTrigger Binding="{Binding Effort}" Value="ultra"><Setter TargetName="Badge" Property="BorderBrush" Value="#94A3B8" /><Setter TargetName="Badge" Property="Background" Value="#202830" /><Setter TargetName="BadgeText" Property="Foreground" Value="#CBD5E1" /></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <DataTemplate x:Key="ScoreCell">
      <TextBlock Text="{Binding WeightedScoreText}" Foreground="#39FF14" FontWeight="Bold" FontFamily="Consolas" FontSize="15" Margin="5,0">
        <TextBlock.Effect><DropShadowEffect Color="#39FF14" BlurRadius="9" ShadowDepth="0" Opacity="0.6" /></TextBlock.Effect>
      </TextBlock>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="20" Background="#05080A">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="280" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="130" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,10" Background="#0A1E16">
      <StackPanel DockPanel.Dock="Left">
        <TextBlock Text="◉ 众测雷达 · GPT 模型评分" FontSize="23" FontWeight="Bold" Foreground="#00E5FF">
          <TextBlock.Effect><DropShadowEffect Color="#00E5FF" BlurRadius="14" ShadowDepth="0" Opacity="0.65" /></TextBlock.Effect>
        </TextBlock>
        <TextBlock Text="公开实测  /  本机预读缓存  /  深色雷达视图" Margin="0,3,0,0" Foreground="#7BB58B" />
      </StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="OpenSiteButton" Content="打开雷达网站" Click="OpenSite_Click" />
        <Button x:Name="RefreshButton" Content="立即更新" Click="Refresh_Click" />
      </StackPanel>
    </DockPanel>
    <TextBlock x:Name="StatusText" Grid.Row="1" Margin="0,0,0,10" TextWrapping="Wrap" Foreground="#8AB99C" />
    <TabControl x:Name="BenchmarkTabs" Grid.Row="2" Margin="0,0,0,10" Background="#0A100A" BorderBrush="#24402C">
      <TabItem Header="软件工程 · DeepSWE" Tag="deep-swe" />
      <TabItem Header="视觉推理 · 庞贝壁画" Tag="pompeii-adjacency" />
    </TabControl>
    <DockPanel Grid.Row="3" Margin="0,0,0,8">
      <TextBlock Text="✦ 综合选择 · 当前频道所有 GPT 推理档位" FontSize="16" FontWeight="SemiBold" Foreground="#39FF14" DockPanel.Dock="Left" VerticalAlignment="Center" />
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
        <TextBlock Text="价格" Foreground="#F59E0B" VerticalAlignment="Center" />
        <Slider x:Name="PriceWeight" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="3" Width="90" Margin="5,0,3,0" />
        <TextBlock x:Name="PriceWeightText" Width="22" VerticalAlignment="Center" />
        <TextBlock Text="IQ" Foreground="#00E5FF" VerticalAlignment="Center" />
        <Slider x:Name="IqWeight" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="3" Width="90" Margin="5,0,3,0" />
        <TextBlock x:Name="IqWeightText" Width="22" VerticalAlignment="Center" />
        <TextBlock Text="速度" Foreground="#4ADE80" VerticalAlignment="Center" />
        <Slider x:Name="SpeedWeight" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" Value="4" Width="90" Margin="5,0,3,0" />
        <TextBlock x:Name="SpeedWeightText" Width="22" VerticalAlignment="Center" />
      </StackPanel>
    </DockPanel>
    <DataGrid x:Name="RankingGrid" Grid.Row="4" AutoGenerateColumns="False" IsReadOnly="True" ColumnHeaderStyle="{StaticResource RadarColumnHeaderStyle}"
              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
              SelectionChanged="RankingGrid_SelectionChanged" HeadersVisibility="Column"
              RowHeight="32">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="GPT 模型" CellTemplate="{StaticResource ModelCell}" Width="1.5*" />
        <DataGridTemplateColumn Header="推理强度" CellTemplate="{StaticResource EffortCell}" Width="*" />
        <DataGridTextColumn Header="IQ" Binding="{Binding IqText}" Width="*" />
        <DataGridTextColumn Header="总样本" Binding="{Binding SamplesText}" Width="*" />
        <DataGridTextColumn Header="参考价 USD/题" Binding="{Binding PriceText}" Width="1.25*" />
        <DataGridTextColumn Header="耗时 分钟/题" Binding="{Binding MinutesText}" Width="1.2*" />
        <DataGridTemplateColumn Header="综合分" CellTemplate="{StaticResource ScoreCell}" Width="*" />
        <DataGridTextColumn Header="来源更新时间" Binding="{Binding SourceText}" Width="1.7*" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="5" Margin="0,7,0,7" Foreground="#8AB99C" TextWrapping="Wrap"
               Text="综合分按当前频道有完整 IQ、参考价和耗时的档位做相对归一化：IQ 越高越好，价格和耗时越低越好；再按右侧权重加权。缺任一项则不排名。拖动权重会自动保存。" />
    <DataGrid x:Name="ModelsGrid" Grid.Row="6" AutoGenerateColumns="False" IsReadOnly="True" ColumnHeaderStyle="{StaticResource RadarColumnHeaderStyle}"
              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single"
              SelectionChanged="ModelsGrid_SelectionChanged" HeadersVisibility="Column"
              RowHeight="30">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="GPT 模型" CellTemplate="{StaticResource ModelCell}" Width="2*" />
        <DataGridTextColumn Header="汇总 IQ" Binding="{Binding ScoreText}" Width="*" />
        <DataGridTextColumn Header="通过样本" Binding="{Binding PassedText}" Width="*" />
        <DataGridTextColumn Header="总样本" Binding="{Binding TotalText}" Width="*" />
        <DataGridTextColumn Header="最近成绩" Binding="{Binding Updated}" Width="1.5*" />
      </DataGrid.Columns>
    </DataGrid>
    <DockPanel Grid.Row="7" Margin="0,10,0,6">
      <TextBlock x:Name="EffortTitle" DockPanel.Dock="Left" Text="⌁ 推理强度详情" FontSize="16" FontWeight="SemiBold" Foreground="#00E5FF" />
      <TextBlock x:Name="SelectedModelText" DockPanel.Dock="Right" Foreground="#8AB99C" VerticalAlignment="Center" />
    </DockPanel>
    <DataGrid x:Name="EffortsGrid" Grid.Row="8" AutoGenerateColumns="False" IsReadOnly="True" ColumnHeaderStyle="{StaticResource RadarColumnHeaderStyle}"
              CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
              RowHeight="31">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="推理强度" CellTemplate="{StaticResource EffortCell}" Width="*" />
        <DataGridTextColumn Header="IQ" Binding="{Binding ScoreText}" Width="*" />
        <DataGridTextColumn Header="通过 / 总样本" Binding="{Binding Samples}" Width="1.2*" />
        <DataGridTextColumn Header="累计运行" Binding="{Binding RunsText}" Width="*" />
        <DataGridTextColumn Header="参考价 (USD)" Binding="{Binding CostText}" Width="1.2*" />
        <DataGridTextColumn Header="耗时 (分钟)" Binding="{Binding MinutesText}" Width="1.1*" />
        <DataGridTextColumn Header="平均步数" Binding="{Binding AgentStepsText}" Width="*" />
        <DataGridTextColumn Header="来源更新时间" Binding="{Binding SourceUpdatedAt}" Width="1.5*" />
        <DataGridTextColumn Header="其他统计" Binding="{Binding AdditionalStats}" Width="2.3*" />
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="9" Margin="0,10,0,0" Foreground="#7BB58B" TextWrapping="Wrap"
               Text="IQ 按各推理强度的通过数与样本数汇总，满分 150。参考价是公开站点的单题 API 等价美元价，不代表订阅实际扣费。表中仅列出雷达标记为 Codex 原生 GPT 的项目。" />
  </Grid>
</Window>
